server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name hkcode.aicodeme.xyz;

    ssl_certificate /etc/letsencrypt/live/hkcode.aicodeme.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hkcode.aicodeme.xyz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 100m;

    gzip on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types application/json application/javascript text/css text/plain text/xml application/xml application/xml+rss text/javascript;

    location ~ ^/(\.env|\.git|\.svn|\.hg|\.DS_Store|\.ssh|\.aws|\.npmrc|\.yarnrc|docker-compose|Caddyfile) {
        return 404;
    }

    location ~* "^/assets/.+-[A-Za-z0-9_-]{8,}\.(?:js|mjs|css|svg|png|jpe?g|webp|avif|gif|woff2?|ttf)$" {
        proxy_pass https://hkcode_origin;
        proxy_ssl_server_name on;
        proxy_ssl_name code.aicodeme.xyz;
        proxy_http_version 1.1;
        proxy_set_header Host code.aicodeme.xyz;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hkcode_connection_upgrade;
        proxy_cache hkcode_assets;
        proxy_cache_key "$scheme$host$request_uri";
        proxy_cache_bypass $http_authorization;
        proxy_no_cache $http_authorization $upstream_http_set_cookie;
        proxy_cache_valid 200 30d;
        proxy_cache_lock on;
        proxy_cache_revalidate on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header X-HKCode-Cache $upstream_cache_status always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
    }

    location = /responses {
        proxy_pass https://hkcode_origin;
        proxy_ssl_server_name on;
        proxy_ssl_name code.aicodeme.xyz;
        proxy_http_version 1.1;
        proxy_set_header Host code.aicodeme.xyz;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hkcode_connection_upgrade;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_connect_timeout 60s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        gzip off;
        add_header X-Accel-Buffering no always;
    }

    location ^~ /v1/ {
        proxy_pass https://hkcode_origin;
        proxy_ssl_server_name on;
        proxy_ssl_name code.aicodeme.xyz;
        proxy_http_version 1.1;
        proxy_set_header Host code.aicodeme.xyz;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hkcode_connection_upgrade;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_connect_timeout 60s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        add_header X-Accel-Buffering no always;
    }

    location ^~ /api/v1/media/review/tasks/ {
        proxy_pass https://hkcode_origin;
        proxy_ssl_server_name on;
        proxy_ssl_name code.aicodeme.xyz;
        proxy_http_version 1.1;
        proxy_set_header Host code.aicodeme.xyz;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hkcode_connection_upgrade;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_connect_timeout 60s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        gzip off;
        add_header X-Accel-Buffering no always;
        access_log off;
    }

    location ^~ /api/ {
        proxy_pass https://hkcode_origin;
        proxy_ssl_server_name on;
        proxy_ssl_name code.aicodeme.xyz;
        proxy_http_version 1.1;
        proxy_set_header Host code.aicodeme.xyz;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hkcode_connection_upgrade;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_connect_timeout 60s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        add_header X-Accel-Buffering no always;
    }

    location / {
        proxy_pass https://hkcode_origin;
        proxy_ssl_server_name on;
        proxy_ssl_name code.aicodeme.xyz;
        proxy_http_version 1.1;
        proxy_set_header Host code.aicodeme.xyz;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hkcode_connection_upgrade;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_connect_timeout 60s;
        proxy_buffering on;
        proxy_buffers 64 16k;
        proxy_busy_buffers_size 128k;
    }

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
}

server {
    listen 80;
    listen [::]:80;
    server_name hkcode.aicodeme.xyz;
    return 301 https://$host$request_uri;
}
