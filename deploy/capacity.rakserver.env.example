# Candidate budget, not an instruction to apply before the capacity gates.
# Append reviewed values to the existing root-only production .env.
CAPACITY_APP_CPUS=16
CAPACITY_APP_MEMORY=8g
CAPACITY_APP_CPU_RESERVATION=4
CAPACITY_APP_MEMORY_RESERVATION=4g
CAPACITY_APP_GOMEMLIMIT=6GiB
CAPACITY_DATABASE_MAX_OPEN_CONNS=120
CAPACITY_DATABASE_MAX_IDLE_CONNS=30
CAPACITY_REDIS_POOL_SIZE=512
CAPACITY_REDIS_MIN_IDLE_CONNS=32
CAPACITY_POSTGRES_CPUS=8
CAPACITY_POSTGRES_MEMORY=16g
CAPACITY_POSTGRES_CPU_RESERVATION=2
CAPACITY_POSTGRES_MEMORY_RESERVATION=8g
CAPACITY_POSTGRES_SHM_SIZE=1g
CAPACITY_POSTGRES_MAX_CONNECTIONS=200
CAPACITY_POSTGRES_SHARED_BUFFERS=4GB
CAPACITY_POSTGRES_EFFECTIVE_CACHE_SIZE=12GB
CAPACITY_POSTGRES_MAINTENANCE_WORK_MEM=512MB
CAPACITY_POSTGRES_AUTOVACUUM_WORK_MEM=256MB
CAPACITY_POSTGRES_WORK_MEM=4MB
CAPACITY_POSTGRES_MAX_WAL_SIZE=4GB
CAPACITY_REDIS_CPUS=2
CAPACITY_REDIS_MEMORY=2g
CAPACITY_REDIS_CPU_RESERVATION=0.5
CAPACITY_REDIS_MEMORY_RESERVATION=512m
CAPACITY_REDIS_MAXCLIENTS=10000
CAPACITY_REDIS_MAXMEMORY=768mb
CAPACITY_REDIS_MAXMEMORY_POLICY=noeviction
# Verified existing RDB/AOF behavior, preserve it during this capacity change.
CAPACITY_REDIS_APPENDONLY=no
CAPACITY_REDIS_SAVE=3600 1 300 100 60 10000
